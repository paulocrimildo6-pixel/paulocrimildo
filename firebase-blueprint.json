{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil, progresso e assinatura do estudante",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "streakDays": { "type": "number" },
        "lastStudyDate": { "type": "string" },
        "translationCount": { "type": "number" },
        "voiceCount": { "type": "number" },
        "loginMethod": { "type": "string" },
        "isBlocked": { "type": "boolean" },
        "isAdmin": { "type": "boolean" },
        "subscription_plan": { "type": "string" },
        "subscription_status": { "type": "string" },
        "cakto_customer_id": { "type": "string" },
        "cakto_product_id": { "type": "string" },
        "cakto_subscription_id": { "type": "string" },
