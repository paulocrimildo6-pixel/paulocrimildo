      "required": ["uid", "email"]
    },
    "SubscriptionEvent": {
      "title": "SubscriptionEvent",
      "description": "Registro de eventos e webhooks da Cakto para auditoria e controle de acesso",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "event_id": { "type": "string" },
        "event_type": { "type": "string" },
        "user_id": { "type": "string" },
        "user_email": { "type": "string" },
